# ==============================================================================
# TokStance - Modelo de Variaveis de Ambiente (.env)
# Copie este arquivo para .env e preencha com seus dados:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuracao do Servidor de Envio de E-mails Gratuito (SMTP)
# ------------------------------------------------------------------------------
# Opcao A: Gmail (Gratuito)
# Requisito no Gmail: Ter autenticacao de dois fatores ativada e gerar uma
# "Senha de App" em: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=coloque_aqui_a_senha_de_app_de_16_letras

# Opcao B: E-mail Institucional UFMG / DCC (Gratuito)
# SMTP_HOST=smtp.dcc.ufmg.br
# SMTP_PORT=587
# SMTP_USER=gustavocunha@dcc.ufmg.br
# SMTP_PASSWORD=sua_senha_do_dcc

# Opcao C: Outlook / Hotmail (Gratuito)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=seu_email@outlook.com
# SMTP_PASSWORD=sua_senha_ou_senha_de_app

# ------------------------------------------------------------------------------
# 2. Credenciais Padrao de Administrador (Opcional)
# ------------------------------------------------------------------------------
TOKSTANCE_ADMIN_USER=admin
TOKSTANCE_ADMIN_PASSWORD=TokStance@Admin2026
TOKSTANCE_INVITE_TOKEN=TOKSTANCE-2026
