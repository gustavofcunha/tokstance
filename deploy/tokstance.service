[Unit]
Description=TokStance - Plataforma de Anotacao e Concordancia em Videos
After=network.target

[Service]
Type=simple
User=gustavocunha
WorkingDirectory=/opt/tokstance
EnvironmentFile=-/opt/tokstance/.env
EnvironmentFile=-/home/gustavocunha/label-framework/tokstance/.env
Environment="PATH=/opt/tokstance/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/tokstance/src:/opt/tokstance"
Environment="PORT=7860"
Environment="HOST=0.0.0.0"
ExecStart=/opt/tokstance/.venv/bin/python3 -m tokstance.main
Restart=always
RestartSec=5s
TimeoutStopSec=4s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
